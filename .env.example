# Copie este arquivo para ".env" (mesma pasta) e preencha.
# NUNCA coloque senhas ou chaves diretamente no código nem no README.
# No Render não existe .env: as variáveis são configuradas no painel (aba "Environment").

# Porta do servidor Express (3001 é usada pelo projeto 3, por isso 3002)
PORT=3002

# Endereço público do site, SEM barra no final. Serve para montar o endereço de retorno do Google.
# No seu PC: http://localhost:3002   |   No Render: https://SEU-APP.onrender.com
APP_URL=http://localhost:3002

# Banco PostgreSQL: postgres://USUARIO:SENHA@MAQUINA:PORTA/BANCO
# Para o banco local no Docker (docker compose up -d):
DATABASE_URL=postgres://questoes:questoes123@localhost:5434/bancoquestoes

# Chave secreta que assina o "crachá" de login (JWT). Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria

# Login com Google (Google Cloud Console > APIs e serviços > Credenciais). Passo a passo no README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IAs gratuitas. Configure pelo menos uma; com mais de uma, o app troca sozinho quando uma
# estiver sobrecarregada ou sem cota. Ordem de uso: Groq -> OpenRouter -> Gemini. Passo a passo no docs/GUIA.md.
# Groq: crie a chave em https://console.groq.com/keys (começa com gsk_)
GROQ_API_KEY=
# OpenRouter: crie a chave em https://openrouter.ai/settings/keys (começa com sk-or-)
OPENROUTER_API_KEY=
# Gemini: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: um modelo do Gemini para tentar ANTES de todos (útil se ativar o faturamento do Gemini)
GEMINI_MODEL=
